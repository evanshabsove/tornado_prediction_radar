<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="">
<% end %>

<header class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 px-4 pb-16 pt-12 text-white sm:px-6">
  <div class="mx-auto flex max-w-6xl items-center gap-4">
    <svg class="h-10 w-10 flex-shrink-0 text-indigo-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="9" stroke-opacity="0.35"/>
      <circle cx="12" cy="12" r="5.5" stroke-opacity="0.6"/>
      <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none"/>
    </svg>
    <div>
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Live Radar Heatmap</h1>
      <p class="mt-1 text-sm text-slate-300">Select a radar site to view its real-time tornado probability heatmap, updated automatically.</p>
    </div>
  </div>
</header>

<div data-controller="live-site-select live-heatmap-map"
     data-live-site-select-api-base-url-value="<%= @radar_api_base_url %>"
     data-live-heatmap-map-api-base-url-value="<%= @radar_api_base_url %>"
     data-action="live-site-select:selected->live-heatmap-map#onSiteSelected"
     class="mx-auto -mt-10 max-w-6xl px-4 pb-16 sm:px-6">

  <div class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-900/5 sm:flex-row sm:items-start sm:justify-between">
    <div class="w-full sm:max-w-sm">
      <label for="live-site-select" class="mb-1.5 block text-sm font-medium text-slate-700">Radar Site</label>
      <select id="live-site-select"
              data-live-site-select-target="select"
              data-action="change->live-site-select#select"
              disabled
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline focus:outline-2 focus:outline-offset-1 focus:outline-indigo-500 disabled:bg-slate-50 disabled:text-slate-400">
        <option>Loading sites…</option>
      </select>
      <p data-live-site-select-target="loading" class="mt-1.5 text-xs text-slate-500">
        <span class="mr-1.5 inline-block h-3 w-3 align-[-2px] animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500"></span>
        Loading radar sites…
      </p>
      <p data-live-site-select-target="error" class="mt-1.5 hidden rounded-md bg-rose-50 px-2 py-1 text-xs text-rose-700"></p>
    </div>

    <div class="w-full sm:w-auto sm:text-right">
      <p class="mb-1.5 text-sm font-medium text-slate-700">Status</p>
      <p data-live-heatmap-map-target="loading" class="hidden text-xs text-slate-500">
        <span class="mr-1.5 inline-block h-3 w-3 align-[-2px] animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500"></span>
        Loading heatmap…
      </p>
      <p data-live-heatmap-map-target="status" class="hidden text-xs text-slate-500"></p>
    </div>
  </div>

  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5">
    <div class="flex flex-col gap-2 border-b border-slate-100 px-5 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-sm font-semibold text-slate-700">Tornado Probability Heatmap</h2>
        <p class="text-xs text-slate-400">Hover a tile for its exact probability. Most tiles stay near 0% in quiet weather.</p>
      </div>
      <div class="flex items-center gap-2 text-xs text-slate-500">
        <span>0%</span>
        <span class="h-2 w-24 rounded-full bg-gradient-to-r from-cyan-600 via-amber-500 to-rose-600"></span>
        <span>100%</span>
      </div>
    </div>
    <div data-live-heatmap-map-target="map" id="live-map" class="h-[550px] w-full"></div>
  </div>
</div>
