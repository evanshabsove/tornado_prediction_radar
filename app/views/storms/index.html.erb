<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="">
<% end %>

<header class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 px-4 pb-16 pt-12 text-white sm:px-6">
  <div class="mx-auto flex max-w-6xl items-center gap-4">
    <svg class="h-10 w-10 flex-shrink-0 text-indigo-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="9" stroke-opacity="0.35"/>
      <circle cx="12" cy="12" r="5.5" stroke-opacity="0.6"/>
      <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none"/>
    </svg>
    <div>
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Tornado Detection Radar</h1>
      <p class="mt-1 text-sm text-slate-300">Select a storm to view its most recent reflectivity scan and modeled tornado probability.</p>
    </div>
  </div>
</header>

<div data-controller="storm-search radar-map"
     data-storm-search-api-base-url-value="<%= @radar_api_base_url %>"
     data-radar-map-api-base-url-value="<%= @radar_api_base_url %>"
     data-action="storm-search:selected->radar-map#onStormSelected"
     class="mx-auto -mt-10 max-w-6xl px-4 pb-16 sm:px-6">

  <div class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-900/5 sm:flex-row sm:items-start sm:justify-between">
    <div class="w-full sm:max-w-sm">
      <label for="storm-search-input" class="mb-1.5 block text-sm font-medium text-slate-700">Storm ID</label>
      <div class="relative">
        <input id="storm-search-input" type="text"
               data-storm-search-target="input"
               data-action="input->storm-search#filter focus->storm-search#filter keydown->storm-search#onKeydown blur->storm-search#onBlur"
               placeholder="Search storm ID…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="storm-search-list"
               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:outline focus:outline-2 focus:outline-offset-1 focus:outline-indigo-500 disabled:bg-slate-50 disabled:text-slate-400">
        <ul id="storm-search-list" role="listbox" data-storm-search-target="list"
            class="absolute inset-x-0 top-full z-20 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-slate-200 bg-white py-1 shadow-lg"></ul>
      </div>
      <p data-storm-search-target="loading" class="mt-1.5 text-xs text-slate-500">
        <span class="mr-1.5 inline-block h-3 w-3 align-[-2px] animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500"></span>
        Loading storm list…
      </p>
      <p data-storm-search-target="error" class="mt-1.5 hidden rounded-md bg-rose-50 px-2 py-1 text-xs text-rose-700"></p>
    </div>

    <div class="w-full sm:w-auto sm:text-right">
      <p class="mb-1.5 text-sm font-medium text-slate-700">Predictions by model</p>
      <div data-radar-map-target="predictions" class="hidden flex-col items-end gap-1.5"></div>
      <p data-radar-map-target="placeholder" class="text-sm text-slate-400">Select a storm to see its prediction</p>
      <p data-radar-map-target="loading" class="mt-1.5 hidden text-xs text-slate-500">
        <span class="mr-1.5 inline-block h-3 w-3 align-[-2px] animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500"></span>
        Loading prediction…
      </p>
      <p data-radar-map-target="error" class="mt-1.5 hidden rounded-md bg-rose-50 px-2 py-1 text-xs text-rose-700"></p>
    </div>
  </div>

  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
      <h2 class="text-sm font-semibold text-slate-700">Radar Reflectivity</h2>
      <div class="flex items-center gap-3 text-xs text-slate-500">
        <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>Low</span>
        <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-amber-500"></span>Moderate</span>
        <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-rose-500"></span>High</span>
      </div>
    </div>
    <div data-radar-map-target="map" id="storm-map" class="h-[550px] w-full"></div>
  </div>
</div>
