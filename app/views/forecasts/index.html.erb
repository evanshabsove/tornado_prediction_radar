<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="">
<% end %>

<header class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 px-4 pb-16 pt-12 text-white sm:px-6">
  <div class="mx-auto flex max-w-6xl items-center gap-4">
    <svg class="h-10 w-10 flex-shrink-0 text-indigo-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="9" stroke-opacity="0.35"/>
      <circle cx="12" cy="12" r="5.5" stroke-opacity="0.6"/>
      <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none"/>
    </svg>
    <div>
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Tornado Forecast</h1>
      <p class="mt-1 text-sm text-slate-300">Relative tornado risk in two 4-hour windows from each hourly HRRR model run. Tiers show where risk is highest, not how likely a tornado is.</p>
    </div>
  </div>
</header>

<div data-controller="forecast-select forecast-map forecast-reports"
     data-forecast-select-api-base-url-value="<%= @forecast_api_base_url %>"
     data-forecast-map-api-base-url-value="<%= @forecast_api_base_url %>"
     data-forecast-reports-api-base-url-value="<%= @forecast_api_base_url %>"
     data-action="forecast-select:selected->forecast-map#onSelected
                  forecast-select:selected->forecast-reports#onSelected
                  forecast-reports:loaded->forecast-map#onReportsLoaded
                  forecast-reports:cleared->forecast-map#onReportsCleared"
     class="mx-auto -mt-10 max-w-6xl px-4 pb-16 sm:px-6">

  <div class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-900/5 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex w-full flex-col gap-4 sm:flex-row sm:items-start">
      <div>
        <p id="forecast-mode-label" class="mb-1.5 text-sm font-medium text-slate-700">Mode</p>
        <div role="group" aria-labelledby="forecast-mode-label" class="inline-flex overflow-hidden rounded-lg border border-slate-300 text-sm font-medium">
          <% [["live", "Live"], ["replay", "Replay"]].each do |mode, label| %>
            <button type="button"
                    data-forecast-select-target="modeButton"
                    data-mode="<%= mode %>"
                    data-action="click->forecast-select#selectMode"
                    class="bg-white px-4 py-2 text-slate-700 <%= "border-l border-slate-300" if mode == "replay" %>">
              <%= label %>
            </button>
          <% end %>
        </div>
      </div>

      <div class="w-full sm:max-w-xs">
        <label for="forecast-run-select" data-forecast-select-target="runLabel" class="mb-1.5 block text-sm font-medium text-slate-700">Model run (UTC)</label>
        <select id="forecast-run-select"
                data-forecast-select-target="runSelect"
                data-action="change->forecast-select#selectRun"
                disabled
                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline focus:outline-2 focus:outline-offset-1 focus:outline-indigo-500 disabled:bg-slate-50 disabled:text-slate-400">
          <option>Loading runs…</option>
        </select>
        <p data-forecast-select-target="loading" class="mt-1.5 text-xs text-slate-500">
          <span class="mr-1.5 inline-block h-3 w-3 align-[-2px] animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500"></span>
          Loading model runs…
        </p>
        <p data-forecast-select-target="error" class="mt-1.5 hidden rounded-md bg-rose-50 px-2 py-1 text-xs text-rose-700"></p>
      </div>

      <div>
        <p id="forecast-bin-label" class="mb-1.5 text-sm font-medium text-slate-700">Valid window (UTC)</p>
        <div role="group" aria-labelledby="forecast-bin-label" class="inline-flex overflow-hidden rounded-lg border border-slate-300 text-sm font-medium">
          <% [0, 1].each do |bin| %>
            <button type="button"
                    data-forecast-select-target="binButton"
                    data-bin="<%= bin %>"
                    data-action="click->forecast-select#selectBin"
                    disabled
                    class="bg-white px-4 py-2 text-slate-700 disabled:cursor-not-allowed disabled:text-slate-400 <%= "border-l border-slate-300" if bin == 1 %>">
              …
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <button type="button"
            data-action="click->forecast-select#refresh"
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 sm:w-auto">
      Refresh
    </button>
  </div>

  <div class="mt-6 grid items-start gap-6 lg:grid-cols-3">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5 lg:col-span-2">
      <div class="border-b border-slate-100 px-5 py-3">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-sm font-semibold text-slate-700">
            Valid <span data-forecast-map-target="validWindow">—</span>
          </h2>
          <span data-forecast-map-target="badge" class="hidden rounded-full px-2 py-0.5 text-xs font-medium"></span>
          <span data-forecast-map-target="loading" class="hidden text-xs text-slate-500">
            <span class="mr-1.5 inline-block h-3 w-3 align-[-2px] animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500"></span>
            Loading forecast…
          </span>
        </div>
        <p data-forecast-map-target="error" class="mt-1.5 hidden rounded-md bg-rose-50 px-2 py-1 text-xs text-rose-700"></p>
        <p data-forecast-map-target="retrospectiveNote" class="mt-2 hidden rounded-md border border-violet-200 bg-violet-50 px-2 py-1 text-xs text-violet-800"></p>
        <p class="mt-1 text-xs text-slate-400">Hover or tap a cell for its tier. A run is published about an hour after its start time, so the first window is already about an hour old when it appears.</p>
      </div>
      <div data-forecast-map-target="map" class="h-[600px] w-full"></div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-900/5">
        <h2 class="text-sm font-semibold text-slate-700">Forecast details</h2>
        <dl class="mt-3 space-y-2 text-xs text-slate-500">
          <div>
            <dt class="font-medium text-slate-700">Issued</dt>
            <dd data-forecast-map-target="issued">—</dd>
            <dd data-forecast-map-target="age"></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-700">Model</dt>
            <dd data-forecast-map-target="model">—</dd>
          </div>
          <div>
            <dt class="font-medium text-slate-700">Cells in this window</dt>
            <dd data-forecast-map-target="tierCounts">—</dd>
            <dd data-forecast-map-target="noHighNote" class="hidden">No High cells in this window. That is normal, not a failure.</dd>
          </div>
        </dl>
      </div>

      <div data-forecast-reports-target="panel" class="hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-900/5">
        <h2 class="text-sm font-semibold text-slate-700">SPC verification</h2>
        <label class="mt-3 flex items-center gap-1.5 text-sm text-slate-700">
          <input type="checkbox"
                 checked
                 data-forecast-reports-target="toggle"
                 data-action="change->forecast-reports#toggle"
                 class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
          Show tornado reports
        </label>
        <p data-forecast-reports-target="loading" class="mt-2 hidden text-xs text-slate-500">
          <span class="mr-1.5 inline-block h-3 w-3 align-[-2px] animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500"></span>
          Loading reports…
        </p>
        <p data-forecast-reports-target="error" class="mt-2 hidden rounded-md bg-rose-50 px-2 py-1 text-xs text-rose-700"></p>
        <p data-forecast-reports-target="status" class="mt-2 text-xs text-slate-700"></p>
        <ul data-forecast-reports-target="legend" class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500"></ul>
        <p class="mt-3 text-xs text-slate-400">Reports are SPC tornado reports whose touchdown time falls in the selected window. Each track is SPC's straight line from touchdown to lift-off, not a surveyed path, and says nothing about where the tornado was at other moments. Click a report for details.</p>
      </div>

      <div data-controller="forecast-legend"
           data-forecast-legend-api-base-url-value="<%= @forecast_api_base_url %>"
           class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-900/5">
        <h2 class="text-sm font-semibold text-slate-700">Legend</h2>
        <p data-forecast-legend-target="loading" class="mt-2 text-xs text-slate-500">
          <span class="mr-1.5 inline-block h-3 w-3 align-[-2px] animate-spin rounded-full border-2 border-slate-300 border-t-indigo-500"></span>
          Loading tier definitions…
        </p>
        <p data-forecast-legend-target="error" class="mt-2 hidden rounded-md bg-rose-50 px-2 py-1 text-xs text-rose-700"></p>
        <ul data-forecast-legend-target="list" class="mt-3 space-y-3"></ul>
        <div data-forecast-legend-target="evidence" class="mt-4 space-y-2 border-t border-slate-100 pt-3 text-xs text-slate-500"></div>

        <template data-forecast-legend-target="row">
          <li class="flex gap-3">
            <span data-field="swatch" class="mt-0.5 h-4 w-4 flex-shrink-0 rounded border border-slate-200"></span>
            <div>
              <p data-field="name" class="text-sm font-medium text-slate-800"></p>
              <p data-field="description" class="text-xs text-slate-500"></p>
              <p data-field="stats" class="mt-0.5 text-xs text-slate-400"></p>
            </div>
          </li>
        </template>
      </div>
    </div>
  </div>
</div>
